{
  "name": "kimble-rocket-engineering",
  "private": true,
  "version": "0.1.0",
  "description": "KIMBLE Rocket Engineering: an interactive, browser-based 3D learning simulator for launch-vehicle anatomy, materials and mission phases.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:rocket": "tsc -b && vite build --base=/rocket/ --outDir dist-rocket",
    "preview": "vite preview",
    "preview:rocket": "vite preview --base=/rocket/ --outDir dist-rocket",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts",
    "package": "node scripts/package-zip.mjs",
    "e2e:rocket": "BASE=/rocket/ playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
