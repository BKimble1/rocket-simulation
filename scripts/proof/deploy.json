{
  "name": "v2-orbit-deployment",
  "about": "Payload separation in Earth's shadow, with the labelled inspection light (mission played at 2x).",
  "url": "/?v=mission&m=leo&ui=0",
  "width": 640, "height": 360, "frames": 240,
  "setup": [
    { "until": "window.__rocketFrame.location === 'flight'" },
    { "eval": "window.__rocketPlayback.player.pause(); window.__rocketSeekMission(3318); window.__rocketPlayback.player.setRate(2)" },
    { "advance": 30 },
    { "eval": "window.__rocketPlayback.player.play()" }
  ]
}
